#!/usr/bin/make -f

%:
	dh $@ --buildsystem cargo

# The library crates this binary is built from live in the same source tree and
# are not separately useful, so nothing is installed for them.
override_dh_auto_install:
	dh_auto_install -- --bin whelk

# The test suite drives a real shell over a pseudoterminal and spawns processes.
# It passes on a normal machine and is not something to make a build depend on
# inside a buildd chroot.
override_dh_auto_test:
