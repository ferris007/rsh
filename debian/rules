#!/usr/bin/make -f

%:
	dh $@ --buildsystem cargo

# The root of this repository is a workspace -- a virtual manifest, which
# `cargo install` refuses ("found a virtual manifest instead of a package
# manifest"). Pointing it at the shell's own directory gives it a package to
# install; the eight libraries it is built from are siblings in the same source
# tree and resolve by path, needing nothing from the network.
#
# This is also what keeps the build to the shell alone. The benchmarks and the
# eight standalone experiments are other members of the same workspace, and
# nothing here asks for them -- which matters because the benchmarks want
# criterion, and a buildd has no way to fetch it.
override_dh_auto_install:
	dh_auto_install -D crates/whelk -- --bin whelk

# The test suite drives a real shell over a pseudoterminal and spawns
# processes. It passes on a normal machine and is not something to make a
# package build depend on inside a buildd chroot.
override_dh_auto_test:
